# Properly detect languages on Github
*.h linguist-language=C++
*.inc linguist-language=C++
thirdparty/* linguist-vendored

# Normalize EOL for all files that Git considers text files
* text=auto eol=lf
# Except for Windows-only / Visual Studio files
*.bat eol=crlf
*.sln eol=crlf
*.csproj eol=crlf
misc/msvs/* eol=crlf
# And some test files where the EOL matters
*.test.txt -text

# The above only works properly for Git 2.10+, so for older versions
# we need to manually list the binary files we don't want modified.
*.icns binary
*.ico binary
*.jar binary
*.png binary
*.ttf binary
*.tza binary

# Local Godot editor build artifacts are committed for this custom CLI build.
bin/godot.windows.editor.dev.x86_64.console.exe filter=lfs diff=lfs merge=lfs -text
bin/godot.windows.editor.dev.x86_64.console.pdb filter=lfs diff=lfs merge=lfs -text
bin/godot.windows.editor.dev.x86_64.exe filter=lfs diff=lfs merge=lfs -text
bin/godot.windows.editor.dev.x86_64.exp filter=lfs diff=lfs merge=lfs -text
bin/godot.windows.editor.dev.x86_64.lib filter=lfs diff=lfs merge=lfs -text
bin/godot.windows.editor.dev.x86_64.pdb filter=lfs diff=lfs merge=lfs -text
